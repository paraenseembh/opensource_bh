# Credenciais MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dom_bh
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

# Caminho para o CSV exportado do DOM-BH
CSV_PATH=dados/indice_dom_bh.csv

# Controle de scraping
SCRAPING_DELAY=1.5
SCRAPING_MAX_RETRIES=3
SCRAPING_TIMEOUT=30

# Cache local e corpus RAG
CACHE_PATH=corpus/corpus.jsonl
CHUNKS_PATH=corpus/corpus_chunks.jsonl
CHUNK_SIZE=1500
CHUNK_OVERLAP=150
